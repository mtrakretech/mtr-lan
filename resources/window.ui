<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <menu id="main-menu">
    <item><attribute name="label">Minimize / close window</attribute><attribute name="action">window.close</attribute></item>
    <item><attribute name="label">Quit MTR-LAN-Copy</attribute><attribute name="action">app.quit</attribute></item>
  </menu>
  <template class="LanMouseWindow" parent="AdwApplicationWindow">
    <property name="title">MTR-LAN-Copy</property>
    <property name="default-width">1120</property>
    <property name="default-height">800</property>
    <property name="width-request">900</property>
    <property name="height-request">640</property>
    <style><class name="lan-mouse"/></style>
    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar">
            <style><class name="app-header"/></style>
            <property name="title-widget">
              <object class="GtkBox">
                <property name="spacing">12</property>
                <child><object class="GtkImage"><property name="icon-name">input-mouse-symbolic</property><property name="pixel-size">24</property><style><class name="brand-icon"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">MTR-LAN-Copy</property><style><class name="brand-name"/></style></object></child>
              </object>
            </property>
            <child type="end"><object class="GtkMenuButton"><property name="icon-name">open-menu-symbolic</property><property name="menu-model">main-menu</property><property name="tooltip-text">Application menu</property></object></child>
          </object>
        </child>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="vexpand">true</property>
            <property name="child">
              <object class="GtkBox">
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="width-request">200</property>
                    <style><class name="app-sidebar"/></style>
                    <child><object class="GtkLabel"><property name="label">WORKSPACE</property><property name="xalign">0</property><style><class name="sidebar-caption"/></style></object></child>
                    <child><object class="GtkStackSidebar"><property name="stack">main_stack</property><property name="vexpand">true</property><style><class name="page-navigation"/></style></object></child>
                    <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property><style><class name="sidebar-footer"/></style>
                      <child><object class="GtkLabel" id="sidebar_status"><property name="label">●  Connecting</property><property name="xalign">0</property><style><class name="sidebar-service"/></style></object></child>
                      <child><object class="GtkLabel" id="identity_label"><property name="label">This PC</property><property name="xalign">0</property><property name="ellipsize">end</property><property name="max-width-chars">18</property><style><class name="muted"/><class name="small-text"/></style></object></child>
                    </object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="main_stack">
                    <property name="hexpand">true</property><property name="vexpand">true</property><property name="transition-type">crossfade</property><property name="transition-duration">140</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">overview</property><property name="title">Overview</property>
                        <property name="child"><object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="child">
                          <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">24</property><style><class name="workspace-page"/></style>
                            <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property>
                              <child><object class="GtkLabel"><property name="label">Overview</property><property name="xalign">0</property><style><class name="page-title"/></style></object></child>
                              <child><object class="GtkLabel"><property name="label">Your local input-sharing workspace, at a glance.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="page-description"/></style></object></child>
                            </object></child>
                            <child><object class="GtkListBox"><property name="selection-mode">none</property><style><class name="boxed-list"/><class name="service-card"/></style>
                              <child><object class="AdwActionRow" id="status_row"><property name="title">Connecting to service</property><property name="subtitle">Checking the background process…</property><property name="subtitle-lines">0</property><style><class name="hero-status"/></style>
                                <child type="prefix"><object class="GtkImage"><property name="icon-name">network-transmit-receive-symbolic</property><property name="pixel-size">28</property><style><class name="service-icon"/></style></object></child>
                                <child type="suffix"><object class="GtkLabel" id="status_badge"><property name="label">CONNECTING</property><property name="valign">center</property><style><class name="status-badge"/></style></object></child>
                              </object></child>
                            </object></child>
                            <child><object class="GtkBox"><property name="spacing">16</property><property name="homogeneous">true</property>
                              <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><style><class name="metric-card"/></style>
                                <child><object class="GtkLabel"><property name="label">Enabled computers</property><property name="xalign">0</property><style><class name="metric-label"/></style></object></child>
                                <child><object class="GtkLabel" id="peers_metric"><property name="label">0 / 0</property><property name="xalign">0</property><style><class name="metric-value"/></style></object></child>
                                <child><object class="GtkLabel"><property name="label">enabled / configured</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="muted"/><class name="small-text"/></style></object></child>
                              </object></child>
                              <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><style><class name="metric-card"/></style>
                                <child><object class="GtkLabel"><property name="label">Received</property><property name="xalign">0</property><style><class name="metric-label"/></style></object></child>
                                <child><object class="GtkLabel" id="received_metric"><property name="label">0</property><property name="xalign">0</property><style><class name="metric-value"/></style></object></child>
                                <child><object class="GtkLabel"><property name="label">network datagrams</property><property name="xalign">0</property><style><class name="muted"/><class name="small-text"/></style></object></child>
                              </object></child>
                              <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><style><class name="metric-card"/></style>
                                <child><object class="GtkLabel"><property name="label">Sent</property><property name="xalign">0</property><style><class name="metric-label"/></style></object></child>
                                <child><object class="GtkLabel" id="sent_metric"><property name="label">0</property><property name="xalign">0</property><style><class name="metric-value"/></style></object></child>
                                <child><object class="GtkLabel"><property name="label">network datagrams</property><property name="xalign">0</property><style><class name="muted"/><class name="small-text"/></style></object></child>
                              </object></child>
                            </object></child>
                            <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property>
                              <child><object class="GtkLabel"><property name="label">Network activity</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
                              <child><object class="GtkListBox"><property name="selection-mode">none</property><style><class name="boxed-list"/></style>
                                <child><object class="AdwActionRow" id="traffic_row"><property name="title">Waiting for activity</property><property name="subtitle">No network data received yet.</property><property name="subtitle-lines">0</property></object></child>
                              </object></child>
                            </object></child>
                            <child><object class="GtkButton"><property name="label">Manage connections →</property><property name="halign">start</property><signal name="clicked" handler="handle_open_connections" swapped="true"/><style><class name="suggested-action"/></style></object></child>
                          </object>
                        </property></object></property>
                      </object>
                    </child>
                    <child><object class="GtkStackPage"><property name="name">this-pc</property><property name="title">This PC</property><property name="child"><object class="GtkBox" id="local_pc_page"><property name="orientation">vertical</property></object></property></object></child>
                    <child><object class="GtkStackPage"><property name="name">discover</property><property name="title">Discover</property><property name="child"><object class="GtkBox" id="discovery_page"><property name="orientation">vertical</property></object></property></object></child>
                    <child>
                      <object class="GtkStackPage"><property name="name">connections</property><property name="title">Connections</property><property name="child">
                        <object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="child">
                          <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">24</property><style><class name="workspace-page"/></style>
                            <child><object class="GtkBox"><property name="spacing">20</property>
                              <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property><property name="hexpand">true</property>
                                <child><object class="GtkLabel"><property name="label">Connections</property><property name="xalign">0</property><style><class name="page-title"/></style></object></child>
                                <child><object class="GtkLabel"><property name="label">Choose the computers allowed to share input.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="page-description"/></style></object></child>
                              </object></child>
                              <child><object class="GtkButton"><property name="valign">center</property><signal name="clicked" handler="handle_add_client_pressed" swapped="true"/><property name="child"><object class="AdwButtonContent"><property name="icon-name">list-add-symbolic</property><property name="label">Add computer</property></object></property><style><class name="suggested-action"/></style></object></child>
                            </object></child>
                            <child><object class="GtkListBox" id="client_list"><property name="selection-mode">none</property><style><class name="boxed-list"/><class name="connection-list"/></style>
                              <child type="placeholder"><object class="AdwActionRow" id="client_placeholder"><property name="title">No computers added yet</property><property name="subtitle">Use Add computer to enter a trusted device’s hostname or IP address.</property><property name="subtitle-lines">0</property><style><class name="empty-state"/></style><child type="prefix"><object class="GtkImage"><property name="icon-name">network-workgroup-symbolic</property><property name="pixel-size">40</property><style><class name="muted"/></style></object></child></object></child>
                            </object></child>
                            <child><object class="GtkLabel"><property name="label">Enable a computer to allow input sharing. Expand its card to edit the address, port and screen position, then choose Save changes.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="muted"/></style></object></child>
                            <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property><style><class name="notice-card"/></style>
                              <child><object class="GtkLabel"><property name="label">Set up both PCs</property><property name="xalign">0</property><style><class name="section-title"/></style></object></child>
                              <child><object class="GtkLabel"><property name="label">Choose Host on the PC with your keyboard and mouse, and Client on the other PC. Enable each other explicitly. Use This PC to choose a role; Discover finds compatible running apps.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
                            </object></child>
                          </object>
                        </property></object>
                      </property></object>
                    </child>
                    <child><object class="GtkStackPage"><property name="name">logs</property><property name="title">Live logs</property><property name="child"><object class="GtkBox" id="logs_page"><property name="orientation">vertical</property></object></property></object></child>
                    <child>
                      <object class="GtkStackPage"><property name="name">settings</property><property name="title">Settings</property><property name="child">
                        <object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="child">
                          <object class="GtkBox" id="preferences_box"><property name="orientation">vertical</property><property name="spacing">28</property><style><class name="workspace-page"/></style>
                            <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property>
                              <child><object class="GtkLabel"><property name="label">Settings</property><property name="xalign">0</property><style><class name="page-title"/></style></object></child>
                              <child><object class="GtkLabel"><property name="label">Make MTR-LAN-Copy work the way you do.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="page-description"/></style></object></child>
                            </object></child>
                            <child><object class="AdwPreferencesGroup"><property name="title">Network</property><property name="description">Changes are saved in this portable folder.</property>
                              <child><object class="AdwActionRow"><property name="title">Listen port</property><property name="subtitle">UDP port for incoming input-sharing traffic</property><property name="subtitle-lines">0</property>
                                <child type="suffix"><object class="GtkEntry" id="port_entry"><property name="placeholder-text">4242</property><property name="width-chars">7</property><property name="max-width-chars">7</property><property name="xalign">0.5</property><property name="valign">center</property><property name="input-purpose">digits</property><property name="tooltip-text">Listen port, 1–65535</property><signal name="activate" handler="handle_port_edit_apply" swapped="true"/><signal name="changed" handler="handle_port_changed" swapped="true"/></object></child>
                                <child type="suffix"><object class="GtkButton" id="port_edit_apply"><property name="label">Apply</property><property name="visible">false</property><property name="valign">center</property><signal name="clicked" handler="handle_port_edit_apply" swapped="true"/><style><class name="suggested-action"/></style></object></child>
                                <child type="suffix"><object class="GtkButton" id="port_edit_cancel"><property name="icon-name">edit-undo-symbolic</property><property name="tooltip-text">Discard port change</property><property name="visible">false</property><property name="valign">center</property><signal name="clicked" handler="handle_port_edit_cancel" swapped="true"/></object></child>
                              </object></child>
                            </object></child>
                          </object>
                        </property></object>
                      </property></object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
